---
import { sparks } from '../lib/content';
---
<div class="embers" aria-hidden="true">
  {sparks.map((s) => <span style={`left:${s.left};width:${s.size};height:${s.size};animation-duration:${s.dur};animation-delay:${s.delay}`} />)}
</div>
<style>
  .embers { position: absolute; top: 0; left: 0; right: 0; height: 860px; overflow: hidden; pointer-events: none; }
  span { position: absolute; bottom: 0; border-radius: 50%; background: var(--accent); box-shadow: 0 0 10px 2px rgba(255, 107, 53, 0.7); animation: rise linear infinite; opacity: 0; }
</style>
