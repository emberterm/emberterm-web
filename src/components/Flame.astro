---
// Decorative; the visible "EmberTerm" text names the link. `inner` adds the
// highlight used in the nav logo (the footer version is flat).
interface Props { width: number; height: number; inner?: boolean }
const { width, height, inner = false } = Astro.props;
---
<svg class="flame" width={width} height={height} viewBox="0 0 16 18" aria-hidden="true">
  <path d="M8 0 C8 0, 14 5, 14 11 C14 15.4 11.3 18 8 18 C4.7 18 2 15.4 2 11 C2 7 6 3 6 3 C6 3 6 7 8 8 C8 8 10 6 8 0Z" fill="#FF6B35" />
  {inner && <path d="M8 9 C8 9, 10 10.5 10 13 C10 14.7 9.1 16 8 16 C6.9 16 6 14.7 6 13 C6 11 8 9 8 9Z" fill="#ffffff" fill-opacity="0.45" />}
</svg>
<style>
  .flame { transform-origin: 50% 100%; animation: flick 2.6s ease-in-out infinite; }
</style>
